          "name": "4.2 Tampered token (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest('https://cdnjs.cloudflare.com/ajax/libs/jsrsasign/10.9.0/jsrsasign-all-min.js',",
                  "  (err, res) => {",
                  "      let navigator = {};",
                  "      let window = {};",
                  "      eval(res.text());",
                  "",
                  "      let prvJwk = JSON.parse(pm.collectionVariables.get('dpop_private_key'));",
                  "      let pubJwk = JSON.parse(pm.collectionVariables.get('dpop_public_key'));",
                  "      let privateKey = KEYUTIL.getKey(prvJwk);",
                  "",
                  "      // Tamper with the access token (flip a character in the payload)",
                  "      let accessToken = pm.collectionVariables.get('access_token');",
                  "      let parts = accessToken.split('.');",
                  "      let payload = parts[1];",
                  "      let tampered = payload.substring(0, 10) + 'XXXX' + payload.substring(14);",
                  "      let tamperedToken = parts[0] + '.' + tampered + '.' + parts[2];",
                  "      pm.variables.set('tampered_token', tamperedToken);",
                  "",
                  "      // Generate valid DPoP proof but for the tampered token",
                  "      let athHash = KJUR.crypto.Util.hashString(tamperedToken, 'sha256');",
                  "      let ath = hextob64u(athHash);",
                  "",
                  "      let header = { alg: 'RS256', typ: 'dpop+jwt', jwk: pubJwk };",
                  "      let dpopPayload = {",
                  "          jti: pm.variables.replaceIn('{{$guid}}'),",
                  "          htm: pm.request.method,",
                  "          htu: pm.variables.replaceIn(pm.request.url.toString()).split('?')[0],",
                  "          iat: Math.floor(Date.now() / 1000),",
                  "          ath: ath",
                  "      };",
                  "",
                  "      let dpopProof = KJUR.jws.JWS.sign('RS256', JSON.stringify(header), JSON.stringify(dpopPayload), privateKey);",
                  "      pm.variables.set('dpop_proof', dpopProof);",
                  "  });"
                ]
              }
            },
