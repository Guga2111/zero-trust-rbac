{
  "info": {
    "name": "Zero Trust RBAC Seminary",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "access_token", "value": "" },
    { "key": "dpop_private_key", "value": "" },
    { "key": "dpop_public_key", "value": "" },
    { "key": "base_url", "value": "http://localhost:8081" },
    { "key": "keycloak_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "0 - Login",
      "item": [
        {
          "name": "Login MANAGER (maria)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest('https://cdnjs.cloudflare.com/ajax/libs/jsrsasign/10.9.0/jsrsasign-all-min.js',",
                  "  (err, res) => {",
                  "      let navigator = {};",
                  "      let window = {};",
                  "      eval(res.text());",
                  "",
                  "      let keypair = KEYUTIL.generateKeypair('RSA', 2048);",
                  "",
                  "      pm.collectionVariables.set('dpop_private_key', JSON.stringify(KEYUTIL.getJWKFromKey(keypair.prvKeyObj)));",
                  "      pm.collectionVariables.set('dpop_public_key', JSON.stringify(KEYUTIL.getJWKFromKey(keypair.pubKeyObj)));",
                  "",
                  "      let jwk = KEYUTIL.getJWKFromKey(keypair.pubKeyObj);",
                  "      let header = { alg: 'RS256', typ: 'dpop+jwt', jwk: jwk };",
                  "      let payload = {",
                  "          jti: pm.variables.replaceIn('{{$guid}}'),",
                  "          htm: pm.request.method,",
                  "          htu: pm.variables.replaceIn(pm.request.url.toString()).split('?')[0],",
                  "          iat: Math.floor(Date.now() / 1000)",
                  "      };",
                  "",
                  "      let dpopProof = KJUR.jws.JWS.sign('RS256', JSON.stringify(header), JSON.stringify(payload), keypair.prvKeyObj);",
                  "      pm.variables.set('dpop_proof', dpopProof);",
                  "  });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "",
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.access_token).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "DPoP", "value": "{{dpop_proof}}" },
              { "key": "Authorization", "value": "DPoP {{access_token}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "api-client" },
                { "key": "grant_type", "value": "password" },
                { "key": "username", "value": "maria" },
                { "key": "password", "value": "123" }
              ]
            },
            "url": "{{keycloak_url}}/realms/zerotrust/protocol/openid-connect/token"
          }
        },
