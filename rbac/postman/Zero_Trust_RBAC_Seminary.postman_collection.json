      "item": [
        {
          "name": "2.1 Missing DPoP header (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejected without DPoP proof header', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "DPoP {{access_token}}" }
            ],
            "url": "{{base_url}}/api/documents"
          }
        },
        {
          "name": "2.2 Stolen token - wrong key pair (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Simulates an attacker who stole the access_token but generates their own key pair",
                  "pm.sendRequest('https://cdnjs.cloudflare.com/ajax/libs/jsrsasign/10.9.0/jsrsasign-all-min.js',",
                  "  (err, res) => {",
                  "      let navigator = {};",
                  "      let window = {};",
                  "      eval(res.text());",
                  "",
                  "      // ATTACKER generates a NEW key pair (different from the one bound to the token)",
                  "      let attackerKeypair = KEYUTIL.generateKeypair('RSA', 2048);",
                  "      let attackerPubJwk = KEYUTIL.getJWKFromKey(attackerKeypair.pubKeyObj);",
                  "",
                  "      let accessToken = pm.collectionVariables.get('access_token');",
                  "      let athHash = KJUR.crypto.Util.hashString(accessToken, 'sha256');",
                  "      let ath = hextob64u(athHash);",
                  "",
                  "      let header = { alg: 'RS256', typ: 'dpop+jwt', jwk: attackerPubJwk };",
                  "      let payload = {",
                  "          jti: pm.variables.replaceIn('{{$guid}}'),",
                  "          htm: pm.request.method,",
                  "          htu: pm.variables.replaceIn(pm.request.url.toString()).split('?')[0],",
                  "          iat: Math.floor(Date.now() / 1000),",
                  "          ath: ath",
                  "      };",
                  "",
                  "      let dpopProof = KJUR.jws.JWS.sign('RS256', JSON.stringify(header), JSON.stringify(payload), attackerKeypair.prvKeyObj);",
                  "      pm.variables.set('dpop_proof', dpopProof);",
                  "  });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stolen token rejected - JKT mismatch', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "DPoP", "value": "{{dpop_proof}}" },
              { "key": "Authorization", "value": "DPoP {{access_token}}" }
            ],
            "url": "{{base_url}}/api/documents"
          }
        },
        {
          "name": "2.3 Missing ath claim (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest('https://cdnjs.cloudflare.com/ajax/libs/jsrsasign/10.9.0/jsrsasign-all-min.js',",
                  "  (err, res) => {",
                  "      let navigator = {};",
                  "      let window = {};",
                  "      eval(res.text());",
                  "",
                  "      let prvJwk = JSON.parse(pm.collectionVariables.get('dpop_private_key'));",
                  "      let pubJwk = JSON.parse(pm.collectionVariables.get('dpop_public_key'));",
                  "      let privateKey = KEYUTIL.getKey(prvJwk);",
                  "",
                  "      // Deliberately omitting ath claim",
                  "      let header = { alg: 'RS256', typ: 'dpop+jwt', jwk: pubJwk };",
                  "      let payload = {",
                  "          jti: pm.variables.replaceIn('{{$guid}}'),",
                  "          htm: pm.request.method,",
                  "          htu: pm.variables.replaceIn(pm.request.url.toString()).split('?')[0],",
                  "          iat: Math.floor(Date.now() / 1000)",
                  "      };",
                  "",
                  "      let dpopProof = KJUR.jws.JWS.sign('RS256', JSON.stringify(header), JSON.stringify(payload), privateKey);",
                  "      pm.variables.set('dpop_proof', dpopProof);",
                  "  });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
